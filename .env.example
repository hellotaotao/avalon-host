DATABASE_URL=

# Local Vite dev uses browser localStorage by default.
# Set this only when running a local Vercel API server with DATABASE_URL available.
VITE_USE_NEON_API=false

# Optional server-only AI Table provider keys. Do not expose these with VITE_ prefixes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-6-luna
# OPENROUTER_REASONING_EFFORT=medium

# Previous comparison baseline: OPENAI_MODEL=gpt-5.4-mini and OPENAI_REASONING_EFFORT=none.
