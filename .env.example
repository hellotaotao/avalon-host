DATABASE_URL=

# Local Vite dev uses browser localStorage by default.
# Set this only when running a local Vercel API server with DATABASE_URL available.
VITE_USE_NEON_API=false

# Optional server-only AI Table provider keys. Do not expose these with VITE_ prefixes.
# The model and reasoning effort are set in api/ai-avalon.ts, not here.
OPENAI_API_KEY=
# OPENROUTER_API_KEY=
