{
  "compilerOptions": {
    "composite": true,
    "outDir": "node_modules/.tmp/tsconfig-node",
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts", "src/shareMeta.ts"]
}
